# Copy this file to ".env" and fill in real values. Never commit ".env".

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | production   (testing is used only by pytest)
APP_ENV=development

# Set to 1 only on your own machine for the interactive debugger. NEVER in production.
FLASK_DEBUG=0

# Optional: override the SQLite location, e.g. sqlite:///C:/Users/you/u_expense_tracker.db
# DATABASE_URL=

# Rate-limit counters. memory:// is fine for one process; use Redis in production so
# limits survive restarts and are shared by every worker, e.g. redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# Tunables (defaults shown)
# LOGIN_RATE_LIMIT=10 per minute;60 per hour
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# CURRENCY_SYMBOL=₹

# Number of reverse proxies in front of the app (so client IPs are read correctly). 0 = none.
TRUSTED_PROXY_COUNT=0
