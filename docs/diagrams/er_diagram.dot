digraph ER {
  graph [rankdir=LR, bgcolor="#F6F4F0", pad=0.4, nodesep=0.7, ranksep=1.3, fontname="Helvetica", label="Entity-relationship diagram: U - Secure Daily Expense Tracker", labelloc=t, fontsize=18, fontcolor="#292725"];
  node  [shape=plaintext, fontname="Helvetica", fontsize=12, fontcolor="#292725"];
  edge  [fontname="Helvetica", fontsize=11, color="#94636D", fontcolor="#292725", penwidth=1.6];

  users [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#E9E5DF" BGCOLOR="#FFFFFF">
      <TR><TD BGCOLOR="#B77983" COLSPAN="2"><FONT COLOR="#FFFFFF"><B>users</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id : INTEGER</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">username : VARCHAR(30)</TD></TR>
      <TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">email : VARCHAR(254)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">password_hash : VARCHAR(256)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at : DATETIME</TD></TR>
    </TABLE>>];

  expenses [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#E9E5DF" BGCOLOR="#FFFFFF">
      <TR><TD BGCOLOR="#B77983" COLSPAN="2"><FONT COLOR="#FFFFFF"><B>expenses</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id : INTEGER</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id : INTEGER  (ON DELETE CASCADE)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">category : VARCHAR(20)  CHECK IN (6 categories)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">amount : BIGINT (paise)  CHECK &gt; 0</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">expense_date : DATE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description : VARCHAR(255)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at, updated_at : DATETIME</TD></TR>
      <TR><TD BGCOLOR="#F0EDE8" COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6F6A64">Indexes: (user_id, expense_date), (user_id, category)</FONT></TD></TR>
    </TABLE>>];

  login_attempts [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#E9E5DF" BGCOLOR="#FFFFFF">
      <TR><TD BGCOLOR="#94636D" COLSPAN="2"><FONT COLOR="#FFFFFF"><B>login_attempts</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id : INTEGER</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">email : VARCHAR(254)  (indexed)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">attempted_at : DATETIME  (indexed)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">success : BOOLEAN</TD></TR>
      <TR><TD BGCOLOR="#F0EDE8" COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6F6A64">Index: (email, attempted_at)</FONT></TD></TR>
    </TABLE>>];

  users -> expenses [label="  1 : N  owns", arrowhead=crow, arrowtail=tee, dir=both];
  users -> login_attempts [label="  logical link by email\l  (no foreign key, so attempts for\l  unknown e-mails are also recorded)\l", style=dashed, color="#A69B91", arrowhead=none];
}
